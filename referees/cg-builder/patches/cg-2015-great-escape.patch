index 92ca77b..cf82e2d 100644
--- a/Referees/The Great Escape/Referee.java	
+++ b/Referees/The Great Escape/Referee.java	
@@ -352,7 +352,8 @@ class Referee extends MultiReferee {
 		width = Math.min(50, Math.max(0, width));
 		height = Math.min(50, Math.max(0, height));
 		
-		Random r=new Random();
+		String seed=prop.getProperty("seed");
+		Random r=seed==null ? new Random() : new Random(Long.parseLong(seed));
 		String[] positions=prop.getProperty("positions", r.nextInt(width)+" "+r.nextInt(width)+" "+r.nextInt(height)+" "+r.nextInt(height)).split(" ");
 		if(positions.length<playerCount) {
